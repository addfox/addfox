# 以下规则对所有目录生效（**/ 表示任意层级）

# addfox default output directory (dev/build)
**/.addfox
# package build output
**/dist
# archives (e.g. addfox build --zip)
**/*.zip
**/*.tar.gz
**/*.tgz
# env (local / secrets)
**/.env
**/.env.*
!**/.env.example
**/node_modules

# 根目录合并后的覆盖率报告（pnpm run test:coverage:report 生成）
/coverage
# coverage
**/coverage

# Rspress docs build output (run pnpm docs:build to generate)
/docs/doc_build
/docs/node_modules

# Playwright e2e
/e2e/test-results
/e2e/playwright-report
/e2e/blob-report
/e2e/playwright/.cache/.rspress
/examples/videoroll-pro
.cursor

# Playwright 默认输出(仓库根目录运行 playwright 时生成)
/test-results

# 本地 AI 工具配置(不进仓库)
.roomodes
.agents
/skills-lock.json